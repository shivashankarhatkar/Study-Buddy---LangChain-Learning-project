# 1. Copy this file and rename the copy to ".env"
# 2. Fill in your keys below
# 3. Never share or commit your real .env file!

# ---------------- Gemini (required) ----------------
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=paste-your-gemini-key-here

# ---------------- LangSmith tracing (optional, but recommended) ----------------
# LangSmith records every step your app takes, so you can SEE what LangChain does.
# Get a free key at https://smith.langchain.com  (Settings -> API Keys)
# Set LANGSMITH_TRACING=false to turn tracing off.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=paste-your-langsmith-key-here
LANGSMITH_PROJECT=study-buddy

# ---------------- Optional: free-tier rate limit ----------------
# If you get "429 / quota exceeded" errors, limit the requests per minute:
# GEMINI_REQUESTS_PER_MINUTE=10
